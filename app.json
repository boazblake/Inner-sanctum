{
  "expo": {
    "name": "Sanctum",
    "slug": "sanctum",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "sanctum",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sanctum records your voice so it can create a private local journal entry."
      },
      "bundleIdentifier": "com.anonymous.sanctum"
    },
    "android": {
      "package": "com.anonymous.sanctum",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Sanctum records your voice so it can create a private local journal entry."
        }
      ],
      [
        "@siteed/audio-studio",
        {
          "microphonePermission": "Sanctum records your voice so it can create a private local journal entry.",
          "enablePhoneStateHandling": false,
          "enableNotifications": false,
          "enableBackgroundAudio": false,
          "enableDeviceDetection": false
        }
      ],
      [
        "llama.rn",
        {
          "forceCxx20": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withFmtPodPatch",
      "./plugins/withWhisperOldArchPatch",
      "./plugins/withSanctumModels",
      "./plugins/withSanctumFoundationModels"
    ],
    "extra": {
      "eas": {
        "projectId": "ccd1c600-1981-4ea2-a2db-653fc05ec4b3"
      }
    },
    "owner": "boazblake"
  }
}
